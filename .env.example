# Clé d'API Google Gemini (si LLM_PROVIDER=gemini)
GEMINI_API_KEY=votre_cle_gemini_ici
GEMINI_MODEL=gemini-flash-lite-latest

# Provider LLM : 'gemini' ou 'local'
LLM_PROVIDER=gemini

# Configuration modèle local (si LLM_PROVIDER=local, ex: Ollama / vLLM)
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1

# Rétention d'historique (jours) et chemins de données
MEMORY_DIR_PATH=data/memory
HISTORY_RETENTION_DAYS=60

# Langue par défaut du système (ex: 'fr', 'en')
DEFAULT_LANGUAGE=fr
