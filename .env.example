# Provider LLM : 'gemini' ou 'local'
LLM_PROVIDER=gemini

# Configuration Gemini (si LLM_PROVIDER=gemini)
GEMINI_API_KEY=votre_cle_gemini_ici
GEMINI_MODEL=gemini-2.5-flash

# Configuration modèle local (si LLM_PROVIDER=local, ex: Ollama / vLLM)
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.1

# Paramètres de génération
LLM_TEMPERATURE=0.7

# Rétention d'historique (jours) et chemin de données
MEMORY_DIR_PATH=data/memory
HISTORY_RETENTION_DAYS=60

# Observabilité et journalisation
LOG_LEVEL=INFO
LOG_FILE=logs/ekko.log

# Persistance SQLite locale
SQLITE_DB_PATH=data/ekko.db
