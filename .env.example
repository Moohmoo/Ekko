# Clé d'API Google Gemini (si LLM_PROVIDER=gemini)
GEMINI_API_KEY=votre_cle_gemini_ici
GEMINI_MODEL=gemini-flash-lite-latest

# Provider LLM : 'gemini' ou 'local'
LLM_PROVIDER=gemini

# Configuration modèle local (si LLM_PROVIDER=local, ex: Ollama / vLLM)
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1

# Chemins de stockage locaux (dans Ekko)
WATCH_DIR_PATH=data/briefings
HISTORY_FILE_PATH=data/history.json
HISTORY_RETENTION_DAYS=60

# Limites de collecte
HN_TOP_LIMIT=15
HN_MIN_SCORE=50
HF_TOP_LIMIT=10
